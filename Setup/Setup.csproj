<Project Sdk="Microsoft.NET.Sdk">

  <!--
    安装器项目：把发布好的主程序 (embed\MonitorControl.exe) 打成单文件安装包。
    embed\MonitorControl.exe 由 MonitorControl\build-installer.ps1 生成，
    单独编译本项目前请先运行该脚本。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MonitorControlSetup</AssemblyName>
    <RootNamespace>MonitorControlSetup</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- dynamic 快捷方式（WScript.Shell COM 晚绑定）需要 -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <EmbeddedResource Include="embed\MonitorControl.exe" />
  </ItemGroup>

</Project>
